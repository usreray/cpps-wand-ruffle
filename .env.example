# Copy this file to .env and fill in your own values.
# Never commit .env — it contains your database password and API keys.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Web
WEB_PORT=8088
WEB_HOSTNAME=localhost

WEB_LEGACY_PLAY=http://old.localhost
WEB_LEGACY_MEDIA=http://legacy.localhost

WEB_VANILLA_PLAY=http://127.0.0.1:8888/play/ruffle.html
WEB_VANILLA_MEDIA=http://127.0.0.1:8888/media

WEB_RECAPTCHA_SITE=
WEB_RECAPTCHA_SECRET=

WEB_SENDGRID_KEY=

# Game
# Public IP address of the server. Players and ruffle.html use this address.
GAME_ADDRESS=127.0.0.1
GAME_LOGIN_PORT=6112

# Snowflake
SNOWFLAKE_HOST=127.0.0.1
SNOWFLAKE_PORT=7002

APPLY_WINDOWMANAGER_OFFSET=False

ALLOW_FORCESTART_SNOW=False
ALLOW_FORCESTART_TUSK=True

MATCHMAKING_TIMEOUT=30

# Email (leave EMAIL_METHOD blank = no email, players activate automatically)
EMAIL_METHOD=
EMAIL_FROM_ADDRESS=
EMAIL_SENDGRID_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=25
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SSL=FALSE
